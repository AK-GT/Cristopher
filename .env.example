# Copia este archivo a .env y pega tu clave real. .env NUNCA se sube al repo.
# La clave gratuita se obtiene en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: cerebro principal (por defecto gemini-flash-latest).
# CRISTOPHER_MODEL=gemini-flash-latest
# Opcional: cerebro de respaldo si el principal agota su cuota (429). Por defecto
# gemini-flash-lite-latest (otro modelo Gemini con function calling). Vacío = desactivado.
# CRISTOPHER_FALLBACK_MODEL=gemini-flash-lite-latest

# Opcional (Fase 4): búsqueda de élite Tavily. Key gratuita en https://tavily.com
# Sin ella, la búsqueda de élite cae a DuckDuckGo automáticamente.
# TAVILY_API_KEY=

# Fase 4 · Google Calendar/Gmail: NO va aquí una key, sino el archivo
# data/google/credentials.json (OAuth "App de escritorio" de Google Cloud).

# Fase 1 (redes sociales) · YouTube: reutiliza el MISMO data/google/credentials.json
# de arriba (mismo proyecto de Google Cloud). No hace falta ninguna variable nueva
# aquí: solo activa "YouTube Data API v3" y "YouTube Analytics API" en ese proyecto
# y corre redes_cuenta_conectar('youtube', '<alias>') una vez por canal — se abrirá
# el navegador para consentir los scopes (youtube.readonly + yt-analytics.readonly +
# youtube.upload, este último para la fase de publicación).

# Fase 2 (redes sociales) · Instagram: app en https://developers.facebook.com/apps
# con el producto "Instagram" → "Business login for Instagram". Con este flujo NO
# hace falta vincular ninguna página de Facebook.
META_APP_ID=
META_APP_SECRET=

# Fase 3 (redes sociales) · TikTok: app en https://developers.tiktok.com/ con el
# producto "Login Kit" (scopes user.info.basic, user.info.stats, video.list). Para
# uso personal basta con Sandbox + Target User, sin esperar revisión.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Fase de publicación (redes sociales) · Instagram Reels: Content Publishing
# exige una URL pública temporal del vídeo. Se usa Cloud Storage del MISMO
# proyecto de Google Cloud (arriba). Activa "Cloud Storage API", crea un bucket
# (nombre globalmente único) y una service account con rol "Storage Object Admin"
# SOLO sobre ese bucket; descarga su clave JSON en
# data/google/gcs-service-account.json (no versionado). Pon aquí el nombre del bucket:
GCS_BUCKET_TEMPORAL=
